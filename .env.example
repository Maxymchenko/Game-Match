# Public Supabase project settings (safe to expose in the browser).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# IGDB/Twitch credentials are SERVER-SIDE ONLY.
# Set these as Supabase Edge Function secrets; never add a VITE_ prefix.
# TWITCH_CLIENT_ID=...
# TWITCH_CLIENT_SECRET=...
# APP_ORIGIN=https://your-production-domain.example
